    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description/>
        <field>u_start_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>constrain_start_date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   //Type appropriate comment here, and begin script below

    var parentSysId = g_form.getValue('parent');
    if (!parentSysId) return; // No parent selected

    // GlideAjax to fetch parent start/end dates
    var ga = new GlideAjax('ParentDateValidator');
    ga.addParam('sysparm_name', 'getParentDates');
    ga.addParam('sysparm_parent_id', parentSysId);
    ga.getXMLAnswer(function(response) {
        if (!response) return;

        var parentDates = JSON.parse(response);
        var childDateParts = newValue.split("-");
        var childDate = new Date(childDateParts[0], childDateParts[1] - 1, childDateParts[2]);

        var parentStart = new Date(parentDates.start);
        var parentEnd = new Date(parentDates.end);

        if (childDate < parentStart) {
            alert("Start Date cannot be before the Parent's Start Date (" + parentDates.start + ").");
            g_form.clearValue('u_start_date');
        } else if (childDate > parentEnd) {
            alert("Start Date cannot be after the Parent's End Date (" + parentDates.end + ").");
            g_form.clearValue('u_start_date');
        }
    });
}
]]></script>
