        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here

    if (gs.nil(current.planned_date))
        return;

    var gd = new GlideDate();
	gd.setValue(current.planned_date);

	var util = new DateDowOrderUtils();
	var result = util.getDayAndOrder.gd;

	if(!result)
		return;
    
    // Set Day of Week (choice value must match dictionary value)
    current.day_of_week = result.value;

    // Set Order (simple weekday-based order)
    current.u_order = result.baseOrder.toString();

    // --- If instead you want occurrence-based order ---
    // current.u_order = util.getOccurrenceOrder(gd);


})(current, previous);]]></script>
